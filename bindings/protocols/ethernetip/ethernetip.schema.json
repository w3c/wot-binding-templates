{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "anyOf": [
    {
      "$ref": "https://www.w3.org/2022/wot/td-schema/v1.1"
    }
  ],
  "definitions": {
    "eipPrimitiveType": {
      "type": "string",
      "enum": [
        "eipv:BOOL",
        "eipv:SINT",
        "eipv:INT",
        "eipv:DINT",
        "eipv:LINT",
        "eipv:USINT",
        "eipv:UINT",
        "eipv:UDINT",
        "eipv:ULINT",
        "eipv:REAL",
        "eipv:LREAL",
        "eipv:BYTE",
        "eipv:WORD",
        "eipv:DWORD",
        "eipv:LWORD",
        "eipv:STRING"
      ]
    },
    "structureDefinition": {
      "type": "object",
      "properties": {
        "typeName": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/fieldDefinition"
          }
        }
      },
      "required": ["typeName", "fields"]
    },
    "fieldDefinition": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/eipPrimitiveType"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "bitOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "description": {
          "type": "string"
        },
        "eipv:structureDefinition": {
          "$ref": "#/definitions/structureDefinition"
        }
      },
      "required": ["name", "offset"],
      "if": {
        "properties": {
          "type": {
            "const": "eipv:BOOL"
          }
        },
        "required": ["type"]
      },
      "then": {
        "required": ["bitOffset"]
      },
      "oneOf": [
        {
          "required": ["type"],
          "not": {
            "required": ["eipv:structureDefinition"]
          }
        },
        {
          "required": ["eipv:structureDefinition"],
          "not": {
            "required": ["type"]
          }
        }
      ]
    },
    "ethernetipForm": {
      "type": "object",
      "properties": {
        "href": {
          "type": "string",
          "format": "uri-reference"
        },
        "op": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["readproperty", "writeproperty", "observeproperty"]
          }
        },
        "type": {
          "$ref": "#/definitions/eipPrimitiveType"
        },
        "pollingTime": {
          "type": "integer",
          "minimum": 0
        },
        "eipv:timeout": {
          "type": "integer",
          "minimum": 0
        },
        "eipv:scale": {
          "type": "number"
        },
        "eipv:offset": {
          "type": "number"
        },
        "eipv:structureDefinition": {
          "$ref": "#/definitions/structureDefinition"
        }
      },
      "required": ["href", "op"],
      "not": {
        "required": ["type", "eipv:structureDefinition"]
      }
    },
    "affordance": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "forms": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/ethernetipForm"
            }
          }
        }
      }
    }
  },
  "type": "object",
  "properties": {
    "@context": {
      "type": "array",
      "contains": {
        "type": "object",
        "properties": {
          "eipv": {
            "type": "string",
            "enum": ["https://www.w3.org/2019/wot/eip", "https://www.w3.org/2026/wot/eip"]
          }
        }
      }
    },
    "base": {
      "type": "string",
      "pattern": "^eip://"
    },
    "eipv:controller": {
      "type": "string",
      "enum": ["ControlLogix", "CompactLogix", "MicroLogix", "SLC500", "PLC5", "Micro800", "Omron"]
    },
    "properties": {
      "$ref": "#/definitions/affordance"
    }
  }
}

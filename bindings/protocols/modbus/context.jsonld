{
    "@context": {
        "xsd": "http://www.w3.org/2001/XMLSchema#",
        "modv":"https://www.w3.org/2019/wot/modbus#",
        "address": {
            "@id": "modv:hasAddress",
            "@type": "xsd:unsignedShort"
        },
        "timeout" : {
            "@id": "modv:hasTimeout",
            "@type": "xsd:unsignedInt"
        }, 
        "zeroBasedAddressing" : {
            "@id": "modv:hasZeroBasedAddressingFlag",
            "@type": "xsd:boolean"
        }, 
        "mostSignificantByte" : {
            "@id": "modv:hasMostSignificantByte",
            "@type": "xsd:boolean"
        }, 
        "mostSignificantWord" : {
            "@id": "modv:hasMostSignificantWord",
            "@type": "xsd:boolean"
        }, 
        "quantity" : {
            "@id": "modv:hasQuantity",
            "@type": "xsd:unsignedShort"
        }, 
        "pollingTime" : {
            "@id": "modv:hasPollingTime",
            "@type": "xsd:unsignedInt"
        }, 
        "unitID": {
            "@id": "modv:hasUnitID",
            "@type": "xsd:unsignedByte"
        },
        "entity" : {
            "@id": "modv:hasEntity",
            "@type": "@vocab"
        }, 
        "function" : {
            "@id": "modv:hasFunction",
            "@type": "@vocab"
        },
        "type" : {
            "@id": "modv:hasPayloadDataType",
            "@type": "@vocab"
        },
        "Coil": "modv:Coil",
        "DiscreteInput" : "modv:DiscreteInput",
        "HoldingRegister": "modv:HoldingRegister",
        "InputRegister": "modv:InputRegister",
        "readCoil": "modv:readCoil",
        "readDiscreteInput": "modv:readDiscreteInput",
        "readHoldingRegisters" : "modv:readHoldingRegisters",
        "readInputRegisters": "modv:readInputRegisters",
        "writeSingleCoil": "modv:writeSingleCoil",
        "writeMultipleCoils": "modv:writeMultipleCoils",
        "writeMultipleHoldingRegisters": "modv:writeMultipleHoldingRegisters",
        "writeSingleHoldingRegister" : "modv:writeSingleHoldingRegister",
        "readFileRecord" : "modv:readFileRecord",
        "readDeviceIdentification": "modv:readDeviceIdentification",
        "integer": "xsd:integer",
        "boolean": "xsd:boolean",
        "string": "xsd:string",
        "float": "xsd:float",
        "decimal": "xsd:decimal",
        "byte": "xsd:byte",
        "short": "xsd:short",
        "int": "xsd:int",
        "long": "xsd:long",
        "unsignedByte": "xsd:unsignedByte",
        "unsignedShort": "xsd:unsignedShort",
        "unsignedInt": "xsd:unsignedInt",
        "unsignedLong": "xsd:unsignedLong",
        "double": "xsd:double",
        "hexBinary": "xsd:hexBinary"
    }
}
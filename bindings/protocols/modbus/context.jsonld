{
    "@context": {
        "@version": 1.1,
        "xsd": "http://www.w3.org/2001/XMLSchema#",
        "modv":"https://www.w3.org/2019/wot/modbus#",
        "modv:address": {
            "@id": "modv:address",
            "@type": "xsd:unsignedShort"
        },
        "modv:timeout" : {
            "@id": "modv:timeout",
            "@type": "xsd:unsignedInt"
        }, 
        "modv:zeroBasedAddressing" : {
            "@id": "modv:zeroBasedAddressing",
            "@type": "xsd:boolean"
        }, 
        "modv:mostSignificantByte" : {
            "@id": "modv:mostSignificantByte",
            "@type": "xsd:boolean"
        }, 
        "modv:mostSignificantWord" : {
            "@id": "modv:mostSignificantWord",
            "@type": "xsd:boolean"
        }, 
        "modv:quantity" : {
            "@id": "modv:quantity",
            "@type": "xsd:unsignedShort"
        }, 
        "modv:pollingTime" : {
            "@id": "modv:pollingTime",
            "@type": "xsd:unsignedInt"
        }, 
        "modv:unitID": {
            "@id": "modv:unitID",
            "@type": "xsd:unsignedByte"
        },
        "modv:entity" : {
            "@id": "modv:entity",
            "@type": "@vocab",
            "@context": {
                "@vocab": "https://www.w3.org/2019/wot/modbus#"
            }
        }, 
        "modv:function" : {
            "@id": "modv:function",
            "@type": "@vocab",
            "@context": {
                "@vocab": "https://www.w3.org/2019/wot/modbus#"
            }
        },
        "modv:type" : {
            "@id": "modv:type",
            "@type": "@id"
        }
    }
}
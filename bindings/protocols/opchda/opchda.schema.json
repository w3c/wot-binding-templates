{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "anyOf": [
    {
      "$ref": "https://www.w3.org/2022/wot/td-schema/v1.1"
    }
  ],
  "definitions": {
    "opchdaTime": {
      "type": "string",
      "anyOf": [
        {
          "format": "date-time"
        },
        {
          "pattern": "^(NOW|SECOND|MINUTE|HOUR|DAY|WEEK|MONTH|YEAR)([+-]([0-9]+(MO|S|M|H|D|W|Y))+)*$"
        }
      ]
    },
    "opchdaAggregateName": {
      "type": "string",
      "enum": [
        "interpolative",
        "total",
        "average",
        "timeAverage",
        "count",
        "standardDeviation",
        "minimumActualTime",
        "minimum",
        "maximumActualTime",
        "maximum",
        "start",
        "end",
        "delta",
        "regressionSlope",
        "regressionConstant",
        "regressionDeviation",
        "variance",
        "range",
        "durationGood",
        "durationBad",
        "percentGood",
        "percentBad",
        "worstQuality",
        "annotations"
      ]
    },
    "opchdaDataType": {
      "type": "string",
      "enum": [
        "opchdav:VT_BOOL",
        "opchdav:VT_I1",
        "opchdav:VT_UI1",
        "opchdav:VT_I2",
        "opchdav:VT_UI2",
        "opchdav:VT_I4",
        "opchdav:VT_UI4",
        "opchdav:VT_I8",
        "opchdav:VT_UI8",
        "opchdav:VT_R4",
        "opchdav:VT_R8",
        "opchdav:VT_CY",
        "opchdav:VT_DATE",
        "opchdav:VT_BSTR"
      ]
    },
    "opchdaOperation": {
      "type": "string",
      "enum": ["readproperty", "writeproperty", "observeproperty", "unobserveproperty", "invokeaction"]
    },
    "opchdaForm": {
      "type": "object",
      "properties": {
        "href": {
          "type": "string",
          "format": "uri-reference"
        },
        "op": {
          "oneOf": [
            {
              "$ref": "#/definitions/opchdaOperation"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/opchdaOperation"
              }
            }
          ]
        },
        "opchdav:method": {
          "type": "string",
          "enum": [
            "ReadRaw",
            "ReadProcessed",
            "ReadAtTime",
            "ReadModified",
            "ReadAttribute",
            "ReadAnnotations",
            "Insert",
            "Replace",
            "InsertReplace",
            "DeleteRaw",
            "DeleteAtTime",
            "InsertAnnotations",
            "AdviseRaw",
            "AdviseProcessed"
          ]
        },
        "opchdav:startTime": {
          "$ref": "#/definitions/opchdaTime"
        },
        "opchdav:endTime": {
          "$ref": "#/definitions/opchdaTime"
        },
        "opchdav:numValues": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "opchdav:bounds": {
          "type": "boolean"
        },
        "opchdav:aggregate": {
          "oneOf": [
            {
              "$ref": "#/definitions/opchdaAggregateName"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            }
          ]
        },
        "opchdav:resampleInterval": {
          "type": "integer",
          "minimum": 0
        },
        "opchdav:numIntervals": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "opchdav:updateInterval": {
          "type": "integer",
          "minimum": 0
        },
        "opchdav:attributeId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "opchdav:type": {
          "$ref": "#/definitions/opchdaDataType"
        },
        "opchdav:timeout": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["href", "op"],
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "anyOf": [
                  {
                    "const": "invokeaction"
                  },
                  {
                    "type": "array",
                    "contains": {
                      "const": "invokeaction"
                    }
                  }
                ]
              }
            }
          },
          "then": {
            "required": ["opchdav:method"]
          }
        },
        {
          "if": {
            "required": ["opchdav:method"],
            "properties": {
              "opchdav:method": {
                "enum": ["ReadAtTime", "DeleteRaw", "DeleteAtTime", "InsertAnnotations"]
              }
            }
          },
          "then": {
            "$ref": "#/definitions/opchdaInvokeActionOnly"
          }
        },
        {
          "if": {
            "required": ["opchdav:method"],
            "properties": {
              "opchdav:method": {
                "enum": ["ReadRaw", "ReadProcessed", "ReadModified", "ReadAttribute", "ReadAnnotations"]
              }
            }
          },
          "then": {
            "properties": {
              "op": {
                "oneOf": [
                  {
                    "enum": ["readproperty", "invokeaction"]
                  },
                  {
                    "type": "array",
                    "items": {
                      "enum": ["readproperty", "invokeaction"]
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": ["opchdav:method"],
            "properties": {
              "opchdav:method": {
                "enum": ["Insert", "Replace", "InsertReplace"]
              }
            }
          },
          "then": {
            "properties": {
              "op": {
                "oneOf": [
                  {
                    "enum": ["writeproperty", "invokeaction"]
                  },
                  {
                    "type": "array",
                    "items": {
                      "enum": ["writeproperty", "invokeaction"]
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": ["opchdav:method"],
            "properties": {
              "opchdav:method": {
                "enum": ["AdviseRaw", "AdviseProcessed"]
              }
            }
          },
          "then": {
            "properties": {
              "op": {
                "oneOf": [
                  {
                    "enum": ["observeproperty", "unobserveproperty"]
                  },
                  {
                    "type": "array",
                    "items": {
                      "enum": ["observeproperty", "unobserveproperty"]
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": ["opchdav:method"],
            "properties": {
              "opchdav:method": {
                "const": "AdviseProcessed"
              }
            }
          },
          "then": {
            "required": ["opchdav:aggregate", "opchdav:resampleInterval"],
            "properties": {
              "opchdav:resampleInterval": {
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "opchdaInvokeActionOnly": {
      "properties": {
        "op": {
          "oneOf": [
            {
              "const": "invokeaction"
            },
            {
              "type": "array",
              "items": {
                "const": "invokeaction"
              }
            }
          ]
        }
      }
    },
    "absoluteOpchdaForm": {
      "if": {
        "required": ["href"],
        "properties": {
          "href": {
            "type": "string",
            "pattern": "^opchda://"
          }
        }
      },
      "then": {
        "$ref": "#/definitions/opchdaForm"
      }
    },
    "relativeForm": {
      "if": {
        "required": ["href"],
        "properties": {
          "href": {
            "type": "string",
            "not": {
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"
            }
          }
        }
      },
      "then": {
        "$ref": "#/definitions/opchdaForm"
      }
    },
    "absoluteOpchdaAffordances": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "forms": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/absoluteOpchdaForm"
            }
          }
        }
      }
    },
    "relativeAffordances": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "forms": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/relativeForm"
            }
          }
        }
      }
    },
    "absoluteOpchdaForms": {
      "properties": {
        "forms": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/absoluteOpchdaForm"
          }
        },
        "properties": {
          "$ref": "#/definitions/absoluteOpchdaAffordances"
        },
        "actions": {
          "$ref": "#/definitions/absoluteOpchdaAffordances"
        },
        "events": {
          "$ref": "#/definitions/absoluteOpchdaAffordances"
        }
      }
    },
    "relativeForms": {
      "properties": {
        "forms": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/relativeForm"
          }
        },
        "properties": {
          "$ref": "#/definitions/relativeAffordances"
        },
        "actions": {
          "$ref": "#/definitions/relativeAffordances"
        },
        "events": {
          "$ref": "#/definitions/relativeAffordances"
        }
      }
    }
  },
  "type": "object",
  "properties": {
    "@context": {
      "type": "array",
      "contains": {
        "type": "object",
        "required": ["opchdav"],
        "properties": {
          "opchdav": {
            "type": "string",
            "const": "https://www.w3.org/2026/wot/opchda"
          }
        }
      }
    },
    "base": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "$ref": "#/definitions/absoluteOpchdaForms"
    },
    {
      "if": {
        "required": ["base"],
        "properties": {
          "base": {
            "type": "string",
            "pattern": "^opchda://"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "base": {
                "pattern": "^opchda://([^/:?#\\[\\]]+|\\[[0-9A-Fa-f:.]+\\])/[^/?#]+/$"
              }
            }
          },
          {
            "$ref": "#/definitions/relativeForms"
          }
        ]
      }
    }
  ]
}
